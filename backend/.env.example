# ---------------------------------------------------------------------------
# FundBridge AI — environment template.
#
# Copy to `backend/.env` (the backend reads backend/.env first, then this file
# at the repo root as a fallback for shared values).
#
# Never commit a real .env — it is in .gitignore. Nothing in this file may ever
# reach the browser except the VITE_* block at the bottom.
#
# Every variable below is validated at startup by backend/src/config/env.ts.
# The process refuses to boot if a required one is missing or unsafe.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Create the role and database first:
#   psql -U postgres -h localhost -f scripts/setup/01-create-database.sql
DATABASE_URL="postgresql://fundbridge:CHANGE_ME@localhost:5432/fundbridge?schema=public"

# Used only by `prisma migrate dev` to diff migrations in isolation.
# Leave unset in CI/production, where `prisma migrate deploy` is used instead.
SHADOW_DATABASE_URL="postgresql://fundbridge:CHANGE_ME@localhost:5432/fundbridge_shadow?schema=public"

# --- Backend ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Startup fails in production if this is still the placeholder.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated allowlist of browser origins. Never `*`: the API sends
# credentials, so a wildcard would defeat the same-origin policy. Startup fails
# in production if this contains `*` or points at localhost.
CORS_ORIGIN=http://localhost:5173

# Set to true ONLY when running behind a trusted reverse proxy. Trusting
# X-Forwarded-For unconditionally would let any client spoof its IP and bypass
# rate limiting.
TRUST_PROXY=false

# SameSite for the session and CSRF cookies: lax | strict | none
#
# Keep `lax` when the frontend and the API share an origin, and locally.
#
# Use `none` when they are different SITES, which is easy to get wrong: two
# *.onrender.com subdomains are different sites, because `onrender.com` is on
# the Public Suffix List. With `lax` in that setup the browser accepts the
# login, stores the cookie, and then sends it on none of the API calls — so the
# app looks signed in and behaves as though it is not.
#
# `none` requires Secure, so startup fails unless NODE_ENV=production. It also
# removes the CSRF protection `lax` gives for free; the double-submit token is
# then the only thing guarding unsafe methods.
COOKIE_SAMESITE=lax

# Cookie domain. Leave unset for a host-only cookie. Set it only when the API
# and frontend are real subdomains of one registrable domain
# (api.example.com + app.example.com) and must share a session. Setting this
# wrongly is worse than leaving it blank: a cookie is removed by name, domain
# and path, so a mismatch makes logout fail silently.
# COOKIE_DOMAIN=example.com

# --- File storage ----------------------------------------------------------
# Uploaded proposals are stored outside the web root with randomised filenames
# and are served only through an authenticated, ownership-checked endpoint.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/proposals
MAX_UPLOAD_BYTES=10485760

# --- Python AI service -----------------------------------------------------
# Leave AI_SERVICE_URL blank to run the backend standalone. Deterministic
# scoring, readiness and matching still work; document extraction and
# LLM-verbalised explanations are reported as unavailable rather than faked.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=60000
# Shared secret so only this backend can call the AI service.
AI_SERVICE_TOKEN=

# --- AI service's own configuration (services/ai/.env) ---------------------
# Read by the Python service, not by the backend. Without a key the service
# returns deterministic, template-based explanations. It never invents facts.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_EMBEDDINGS=true

# --- Frontend --------------------------------------------------------------
# VITE_* variables are compiled into the browser bundle and are PUBLIC.
# Never put a secret, API key or database URL here.
VITE_API_BASE_URL=http://localhost:4000/api

# FundBridge AI service configuration. Copy to .env. Never commit a real .env.

FB_AI_ENV=development
FB_AI_HOST=127.0.0.1
FB_AI_PORT=8000
FB_AI_LOG_LEVEL=info

# Shared secret the Node backend must present in X-Service-Token.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required when FB_AI_ENV=production: an unauthenticated embedding/LLM endpoint
# is a proxy to the provider at the operator's expense.
FB_AI_SERVICE_TOKEN=

# Only the Node backend. A browser origin here would be a bug.
FB_AI_ALLOWED_ORIGINS=http://localhost:4000

# --- Embeddings ------------------------------------------------------------
# 384 dimensions must match SchemeDocumentChunk.embedding in the Prisma schema.
# Changing the model means re-indexing: vectors from two models are not
# comparable, and a mismatch is rejected rather than silently compared.
FB_AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FB_AI_EMBEDDING_DIM=384
FB_AI_ENABLE_EMBEDDINGS=true

# --- LLM providers ---------------------------------------------------------
# A task names a role; the router resolves it to whichever provider is
# configured. Supported: anthropic | openai | gemini | mock | (blank = none).
#
# Leave every key blank to run with no LLM at all. Scores, matching, readiness
# and retrieval all still work; narrative generation reports its own absence.
PRIMARY_LLM_PROVIDER=anthropic
PRIMARY_LLM_MODEL=claude-sonnet-5

# Optional. Used only for tasks where fallback is worthwhile — see
# TASK_POLICIES in app/llm/router.py.
SECONDARY_LLM_PROVIDER=
SECONDARY_LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

FB_AI_LLM_MAX_TOKENS=2048
FB_AI_LLM_TIMEOUT_SECONDS=60

# Upper bound on text accepted for analysis. Also a safety property: an
# enormous document could otherwise push the system prompt out of attention.
FB_AI_MAX_TEXT_CHARS=400000
